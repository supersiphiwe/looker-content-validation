# Copy to .env and fill in real values for local runs.
# These match the environment variables the script and workflow read.

# Looker API credentials (looker_sdk.init40 reads these from the environment)
LOOKERSDK_BASE_URL=https://your-instance.looker.com:19999
LOOKERSDK_CLIENT_ID=your-client-id
LOOKERSDK_CLIENT_SECRET=your-client-secret

# Slack Incoming Webhook. The script reads WEBHOOK_URL locally; the GitHub
# Actions workflow maps the SLACK_WEBHOOK_URL repo secret to this name.
# Omit this to print the report to stdout instead of posting to Slack.
WEBHOOK_URL=XXXXXXXXX/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX
